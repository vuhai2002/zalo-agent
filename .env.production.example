# ===== Runtime =====
# production: log JSON (không dùng pino-pretty) để log gọn và máy đọc được
NODE_ENV=production
LOG_LEVEL=info
# Trên VPS nên trỏ ra ngoài thư mục code, vd /var/lib/zalo-agent
DATA_DIR=./data

# ===== LLM =====
# Router proxy phải chạy 24/7 cùng với bot; router chết thì bot retry rồi báo lỗi
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://9router.vuhai.io.vn/v1
LLM_API_KEY=sk-prod-key
LLM_MODEL=claude-opus-5
# Giới hạn bước tool + token mỗi lượt để chặn cháy ví khi bị spam
LLM_MAX_STEPS=8
LLM_MAX_OUTPUT_TOKENS=2048
# Mức "suy nghĩ" của model (off/low/medium/high/xhigh). medium là cân bằng tốt;
# hạ xuống low nếu chi phí token tăng quá, off thì các việc cần nghĩ từng bước
# (dò vé số, đọc bảng giá) sẽ ẩu đi rõ rệt
LLM_REASONING_EFFORT=medium
# Header x-session-id ổn định theo cuộc chat -> prompt caching của router/upstream.
# Đây là khoản tiết kiệm lớn nhất với agent loop nhiều bước tool: từ bước 2 trở đi
# phần đầu prompt (system + tool schema + history + ảnh) lặp lại y hệt.
# Kiểm chứng: CACHED TOKENS trên dashboard 9Router phải > 0.
LLM_CACHE_SESSION_ENABLED=true

# ===== Đọc ảnh (vision) =====
# auto = tự hỏi router model có đọc được ảnh không (9Router trả capabilities.vision).
# Model không vision -> bot tự bỏ ảnh khỏi request (không tốn băng thông base64 vô ích)
# và dùng model sidecar bên dưới nếu có. on/off = ép tay cho endpoint ngoài 9Router.
LLM_VISION_MODE=auto
# Model "đọc ảnh thuê" khi model chính không vision. Trên prod nên nhập ở trang
# Providers (key lưu DB, mã hóa) thay vì để key trong file env.
# Gemini free: base URL https://generativelanguage.googleapis.com/v1beta/openai
# + model gemini-3.5-flash-lite (~500 lượt/ngày, quota tính theo project; thế hệ
# cũ như 2.5-flash-lite đã bị Google rút serving - trả 404).
VISION_SIDECAR_BASE_URL=
VISION_SIDECAR_MODEL=
VISION_SIDECAR_API_KEY=

# ===== Agent behavior =====
# Múi giờ của bot (IANA) - VPS thường chạy UTC nên PHẢI đặt đúng múi giờ người dùng
BOT_TIMEZONE=Asia/Ho_Chi_Minh
# Key Brave dự phòng - trên prod nên nhập ở trang Tools (lưu DB, mã hóa) để
# không phải sửa file env khi đổi key. DuckDuckGo luôn là nguồn dự phòng cuối.
BRAVE_SEARCH_API_KEY=
# Mỗi kết quả tốn token context - giữ 5 là cân bằng
WEB_SEARCH_MAX_RESULTS=5
# Ký tự tối đa mỗi lần web_fetch - tăng thì bot đọc được trang dài hơn nhưng
# tốn token hơn; đừng hạ dưới 10000 kẻo nội dung thật bị rác đầu trang đẩy ra ngoài
WEB_FETCH_MAX_CHARS=15000
# Lưới đỡ khi fetch tự làm bị chặn: đẩy URL qua Jina Reader (không cần key).
# Cân nhắc quyền riêng tư - URL người dùng gửi sẽ đi qua dịch vụ bên thứ ba.
WEB_FETCH_FALLBACK_ENABLED=true
HISTORY_CONTEXT_LIMIT=20
# Nạp lại tối đa N ảnh gần nhất trong history vào context (0 = tắt hẳn).
# Đây là khoản token ĐẮT NHẤT: mỗi ảnh ~1500-2500 token và bị gửi lại ở MỌI
# bước tool của lượt agent. Đo thực tế: lượt có ảnh ~12.600 token input, lượt
# text thuần chỉ ~2.600. Tăng lên là nhân chi phí, cân nhắc kỹ.
HISTORY_IMAGE_CONTEXT_LIMIT=1
# Cỡ ảnh lấy từ tin nhắn Zalo: normal | hd | thumb. Zalo resize sẵn nhiều cỡ
# nên không cần thư viện resize; hd tốn gấp mấy lần token mà không đọc chữ số
# rõ hơn. Chỉ đổi sang hd khi thật sự cần đọc chi tiết rất nhỏ.
ZALO_IMAGE_QUALITY=normal
# Ảnh lưu trên đĩa (data/media) bị xóa sau N ngày; tăng nếu cần bot nhớ ảnh lâu hơn
MEDIA_RETENTION_DAYS=7
# Memory lớp 2: ngưỡng gộp tin cũ vào summary thread (càng thấp càng tốn LLM call)
SUMMARY_TRIGGER_MESSAGES=30
# Memory lớp 3: số fact tối đa mỗi người/nhóm
MEMORY_MAX_FACTS_PER_SUBJECT=50
# Chặn file SQLite phình vô hạn khi bot chạy dài ngày: mỗi thread chỉ giữ 500 tin
# mới nhất, tin cũ hơn bị XÓA hẳn sau mỗi lần ghi. Nâng lên nếu sau này cần đọc
# lại lịch sử dài (dashboard, thống kê). Phải >= HISTORY_CONTEXT_LIMIT.
HISTORY_MAX_MESSAGES_PER_THREAD=500
# Prod nên giữ delay >= 800ms để giảm nguy cơ Zalo đánh dấu spam
SEND_DELAY_MIN_MS=800
SEND_DELAY_MAX_MS=2500
# Zalo chặn tin quá dài (error_code 118). Đo được: chính Zalo tự cắt tin dán vào
# thành đoạn 2613 ký tự, nên trần thật >= 2613. Để 2000 cho có biên phòng khi
# Zalo tính theo byte (tiếng Việt ~1.4 byte/ký tự). Nâng lên = ít tin hơn nhưng
# gần ngưỡng vỡ hơn.
ZALO_MAX_MESSAGE_CHARS=2000
# Trần số tin cho 1 lượt trả lời - bắn quá nhiều tin liên tiếp dễ bị đánh dấu spam
ZALO_MAX_MESSAGE_PARTS=5
# Gộp tin cùng thread: 2500ms hợp lý cho chat người thật; hạ xuống nếu cần phản hồi nhanh hơn
MESSAGE_BATCH_DEBOUNCE_MS=2500
# Chu kỳ bắn lại "đang nhập". Hạ xuống nếu chỉ báo bị tắt giữa chừng; nâng lên để
# giảm số request (bật/tắt riêng từng account trên dashboard)
TYPING_REFRESH_MS=3000

# ===== Dashboard web =====
# Server bind 127.0.0.1 - trên VPS PHẢI đứng sau Caddy/Nginx (không expose port trực tiếp)
DASHBOARD_PORT=3900
# BẮT BUỘC đặt password mạnh (dashboard đọc được toàn bộ hội thoại). Không set = tắt.
DASHBOARD_PASSWORD=
# PHẢI để true khi đã có Caddy/Nginx đứng trước và phục vụ qua HTTPS:
# - rate-limit login lấy IP client từ X-Forwarded-For do proxy ghi (entry phải nhất);
#   để false thì mọi request đều tính chung 1 IP là 127.0.0.1 -> 5 lần/phút cho CẢ THIÊN HẠ
# - cookie session được gắn cờ Secure (chỉ đi qua HTTPS)
# Nếu truy cập trực tiếp qua http (vd SSH tunnel vào 127.0.0.1) thì để false;
# để true lúc đó trình duyệt sẽ không gửi cookie và không đăng nhập được.
DASHBOARD_BEHIND_PROXY=true

# ===== Security =====
# BẮT BUỘC khác với key dev; mất key này = mất toàn bộ cookie đã lưu (phải quét QR lại)
CREDENTIALS_ENCRYPTION_KEY=
