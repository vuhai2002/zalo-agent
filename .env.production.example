# Phần lớn tham số dưới đây giờ chỉnh được ngay trên dashboard, ở trang
# "Cấu hình" - đổi là có hiệu lực từ lượt sau, không cần khởi động lại.
# Giá trị trong file này là MẶC ĐỊNH: ô nào chưa chỉnh trên web thì lấy ở đây.
# Riêng NODE_ENV, LOG_*, DATA_DIR, DASHBOARD_* đọc một lần lúc khởi động nên
# vẫn phải sửa ở đây rồi chạy lại bot.

# ===== Runtime =====
# production: log JSON (không dùng pino-pretty) để log gọn và máy đọc được
NODE_ENV=production
LOG_LEVEL=info
# Trên VPS nên trỏ ra ngoài thư mục code, vd /var/lib/zalo-agent
DATA_DIR=./data

# ===== LLM =====
# Router proxy phải chạy 24/7 cùng với bot; router chết thì bot retry rồi báo lỗi
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://9router.vuhai.io.vn/v1
LLM_API_KEY=sk-prod-key
LLM_MODEL=claude-opus-5
# Giới hạn bước tool + token mỗi lượt để chặn cháy ví khi bị spam
LLM_MAX_STEPS=8
# Trần token phần INPUT mỗi lần gọi model - chặn tràn cửa sổ ngữ cảnh và chặn
# cháy ví vì một cuộc trò chuyện dài. Bot tự bỏ ảnh cũ trước, rồi mới bỏ tin cũ.
LLM_CONTEXT_WINDOW=128000
# Chặn vòng lặp công cụ: bot gọi mãi một công cụ vô ích thì dừng sớm thay vì đốt
# hết số bước rồi trả lời cụt. Ngưỡng cảnh báo tự suy ra bằng nửa ngưỡng chặn.
# Ba số này tự động bị kẹp xuống dưới LLM_MAX_STEPS: ngưỡng cao bằng số bước tối
# đa là ngưỡng không bao giờ tới lượt (số bước hết trước). Đặt LLM_MAX_STEPS cao
# hơn thì ba số dưới đây mới có hiệu lực đầy đủ.
TOOL_LOOP_SAME_ARGS_BLOCK=5
TOOL_LOOP_SAME_TOOL_BLOCK=8
TOOL_LOOP_NO_PROGRESS_BLOCK=5
# Trần thời gian cho cả lượt agent (ms). Không có nó thì router treo sẽ khóa
# thread hàng giờ và mọi tin nhắn sau phải xếp hàng chờ. Phải LỚN HƠN
# IMAGE_GEN_TIMEOUT_MS vì thời gian vẽ ảnh tính trong lượt. Mặc định 15 phút.
LLM_TURN_TIMEOUT_MS=900000
# Trần token mỗi lượt. Phải đủ cho lượt tạo file .docx/.xlsx (model viết cả nội
# dung file vào tool call - báo cáo 6 sheet tốn ~7.100 token). Đây là TRẦN, chỉ
# tốn khi model thật sự viết dài; hạ xuống thì phải hạ DOCUMENT_MAX_CHARS theo.
LLM_MAX_OUTPUT_TOKENS=16384
# Mức "suy nghĩ" của model (off/low/medium/high/xhigh). medium là cân bằng tốt;
# hạ xuống low nếu chi phí token tăng quá, off thì các việc cần nghĩ từng bước
# (dò vé số, đọc bảng giá) sẽ ẩu đi rõ rệt
LLM_REASONING_EFFORT=medium
# Header x-session-id ổn định theo cuộc chat -> prompt caching của router/upstream.
# Đây là khoản tiết kiệm lớn nhất với agent loop nhiều bước tool: từ bước 2 trở đi
# phần đầu prompt (system + tool schema + history + ảnh) lặp lại y hệt.
# Kiểm chứng: CACHED TOKENS trên dashboard 9Router phải > 0.
LLM_CACHE_SESSION_ENABLED=true

# ===== Đọc ảnh (vision) =====
# auto = tự hỏi router model có đọc được ảnh không (9Router trả capabilities.vision).
# Model không vision -> bot tự bỏ ảnh khỏi request (không tốn băng thông base64 vô ích)
# và dùng model sidecar bên dưới nếu có. on/off = ép tay cho endpoint ngoài 9Router.
LLM_VISION_MODE=auto
# Model "đọc ảnh thuê" khi model chính không vision. Trên prod nên nhập ở trang
# Providers (key lưu DB, mã hóa) thay vì để key trong file env.
# Gemini free: base URL https://generativelanguage.googleapis.com/v1beta/openai
# + model gemini-3.5-flash-lite (~500 lượt/ngày, quota tính theo project; thế hệ
# cũ như 2.5-flash-lite đã bị Google rút serving - trả 404).
VISION_SIDECAR_BASE_URL=
VISION_SIDECAR_MODEL=
VISION_SIDECAR_API_KEY=

# ===== Agent behavior =====
# Múi giờ của bot (IANA) - VPS thường chạy UTC nên PHẢI đặt đúng múi giờ người dùng
BOT_TIMEZONE=Asia/Ho_Chi_Minh
# Key Brave dự phòng - trên prod nên nhập ở trang Tools (lưu DB, mã hóa) để
# không phải sửa file env khi đổi key. DuckDuckGo luôn là nguồn dự phòng cuối.
BRAVE_SEARCH_API_KEY=
# Mỗi kết quả tốn token context - giữ 5 là cân bằng
WEB_SEARCH_MAX_RESULTS=5
# Ký tự tối đa mỗi lần web_fetch - tăng thì bot đọc được trang dài hơn nhưng
# tốn token hơn; đừng hạ dưới 10000 kẻo nội dung thật bị rác đầu trang đẩy ra ngoài
WEB_FETCH_MAX_CHARS=15000
# Lưới đỡ khi fetch tự làm bị chặn: đẩy URL qua Jina Reader (không cần key).
# Cân nhắc quyền riêng tư - URL người dùng gửi sẽ đi qua dịch vụ bên thứ ba.
WEB_FETCH_FALLBACK_ENABLED=true
HISTORY_CONTEXT_LIMIT=20
# Nạp lại tối đa N ảnh gần nhất trong history vào context (0 = tắt hẳn).
# Đây là khoản token ĐẮT NHẤT: mỗi ảnh ~1500-2500 token và bị gửi lại ở MỌI
# bước tool của lượt agent. Đo thực tế: lượt có ảnh ~12.600 token input, lượt
# text thuần chỉ ~2.600. Tăng lên là nhân chi phí, cân nhắc kỹ.
HISTORY_IMAGE_CONTEXT_LIMIT=1
# Cỡ ảnh lấy từ tin nhắn Zalo: normal | hd | thumb. Zalo resize sẵn nhiều cỡ
# nên không cần thư viện resize; hd tốn gấp mấy lần token mà không đọc chữ số
# rõ hơn. Chỉ đổi sang hd khi thật sự cần đọc chi tiết rất nhỏ.
ZALO_IMAGE_QUALITY=normal
# Ảnh lưu trên đĩa (data/media) bị xóa sau N ngày; tăng nếu cần bot nhớ ảnh lâu hơn
MEDIA_RETENTION_DAYS=7
# ===== Tool tạo file .docx / .xlsx =====
# Chặn nội dung khổng lồ trước khi dựng file (bot đọc tin người lạ). Trên prod nên
# giữ chặt hơn dev nếu VPS yếu - dựng file là việc tốn CPU nhất trong 1 lượt agent.
DOCUMENT_MAX_BLOCKS=60
DOCUMENT_MAX_ROWS=200
DOCUMENT_MAX_CHARS=20000
DOCUMENT_MAX_SHEETS=10
# Trần chống spam: 1 cuộc chat tối đa bao nhiêu file mỗi giờ
DOCUMENT_MAX_PER_HOUR=10

# ===== Tool vẽ ảnh AI =====
# Endpoint OpenAI-compatible /v1/images/generations. Để trống là tắt hẳn tool
# (nó không vào schema nên model cũng không biết là có).
# Trên prod nên cấu hình từ dashboard thay vì env: key nằm trong DB đã mã hóa
# AES-256-GCM, không phơi ra file .env trên máy chủ.
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=
IMAGE_GEN_API_KEY=
# Đây là trần TIỀN chứ không chỉ là trần CPU: mỗi ảnh tính phí một lần. Bot đọc
# tin người lạ nên hạ số này xuống nếu bot đứng trong nhóm đông hoặc nhận tin từ
# người chưa quen.
IMAGE_GEN_MAX_PER_HOUR=10
# ===== Log ra file =====
# Trên prod đây gần như bắt buộc: không có file log thì khi bot lỗi lúc 3 giờ
# sáng, không còn gì để lần lại. File ở data/logs/, xoay vòng mỗi ngày.
# Lưu ý log chứa nội dung tin nhắn người thật - data/ phải nằm ngoài web root
# và không được commit (đã gitignore).
LOG_FILE_ENABLED=true
# Đĩa nhỏ thì hạ xuống 3. Mỗi file là log của một ngày.
LOG_FILE_KEEP_DAYS=7

# ===== Trace từng step của lượt agent =====
# Trên prod đây là thứ DUY NHẤT giúp truy vì sao bot trả lời sai, nên nên bật.
# Nhưng trace lưu NGUYÊN VĂN tin nhắn của người dùng thật: cân nhắc hạ MAX_CHARS
# và RETENTION_DAYS nếu bot phục vụ nhiều người lạ.
AGENT_TRACE_ENABLED=true
AGENT_TRACE_MAX_CHARS=500
# VPS yếu hoặc đĩa nhỏ thì hạ xuống 3. Bảng agent_steps phình nhanh nhất trong DB.
AGENT_TRACE_RETENTION_DAYS=7

# Mức chi tiết khi vẽ: auto | low | medium | high | standard | hd
# high cho ảnh đẹp hơn rõ rệt nhưng nhà cung cấp thường tính phí cao hơn. Đây là
# tham số ĐỔI TIỀN LẤY CHẤT LƯỢNG - cân theo quota thật của bạn.
IMAGE_GEN_QUALITY=high
# Im lặng bao lâu (ms) thì coi là chết. Nhà cung cấp bắn keepalive mỗi 30 giây
# (đo thật) nên 90s là gấp 3 lần - hạ sát 30000 là cắt nhầm lượt vẽ đang khỏe.
IMAGE_GEN_STALL_MS=90000
# Chốt chặn cuối cho cả lượt vẽ (ms). Prompt phức tạp đo được 135 giây, trên web
# có ca 3-4 phút, nên đừng hạ xuống dưới ~300000 kẻo cắt oan.
IMAGE_GEN_TIMEOUT_MS=600000

# Memory lớp 2: ngưỡng gộp tin cũ vào summary thread (càng thấp càng tốn LLM call)
SUMMARY_TRIGGER_MESSAGES=30
# Memory lớp 3: số fact tối đa mỗi người/nhóm
MEMORY_MAX_FACTS_PER_SUBJECT=50
# Chặn file SQLite phình vô hạn khi bot chạy dài ngày: mỗi thread chỉ giữ 500 tin
# mới nhất, tin cũ hơn bị XÓA hẳn sau mỗi lần ghi. Nâng lên nếu sau này cần đọc
# lại lịch sử dài (dashboard, thống kê). Phải >= HISTORY_CONTEXT_LIMIT.
HISTORY_MAX_MESSAGES_PER_THREAD=500
# Prod nên giữ delay >= 800ms để giảm nguy cơ Zalo đánh dấu spam
SEND_DELAY_MIN_MS=800
SEND_DELAY_MAX_MS=2500
# Zalo chặn tin quá dài (error_code 118). Đo được: chính Zalo tự cắt tin dán vào
# thành đoạn 2613 ký tự, nên trần thật >= 2613. Để 2000 cho có biên phòng khi
# Zalo tính theo byte (tiếng Việt ~1.4 byte/ký tự). Nâng lên = ít tin hơn nhưng
# gần ngưỡng vỡ hơn.
ZALO_MAX_MESSAGE_CHARS=2000
# Trần số tin cho 1 lượt trả lời - bắn quá nhiều tin liên tiếp dễ bị đánh dấu spam
ZALO_MAX_MESSAGE_PARTS=5
# Gộp tin cùng thread: 2500ms hợp lý cho chat người thật; hạ xuống nếu cần phản hồi nhanh hơn
MESSAGE_BATCH_DEBOUNCE_MS=2500
# Chu kỳ bắn lại "đang nhập". Hạ xuống nếu chỉ báo bị tắt giữa chừng; nâng lên để
# giảm số request (bật/tắt riêng từng account trên dashboard)
TYPING_REFRESH_MS=3000

# ===== Lịch hẹn (scheduler): bot tự nhắn theo lịch =====
# Rủi ro khoá nick cao nhất của cả dự án - đừng nới các trần dưới đây khi chưa
# quan sát log sạch với một job "once" duy nhất.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=30000
# every/cron dày hơn mức này (phút) bị chặn ngay lúc tạo job
SCHEDULER_MIN_INTERVAL_MINUTES=5
SCHEDULER_MAX_JOBS_PER_THREAD=20
# Trần tin chủ động mỗi thread mỗi ngày (đếm theo ngày BOT_TIMEZONE) - lưới đỡ
# cuối, độc lập với chặn lúc tạo job
SCHEDULER_MAX_PROACTIVE_PER_DAY=10
# Giãn cách (ms) giữa 2 tin chủ động bất kỳ thread nào, hàng đợi toàn cục
SCHEDULER_SEND_GAP_MS=20000
# Job "once" trễ quá mức này (phút) vẫn gửi, chỉ thêm nhãn "nhắc trễ"
SCHEDULER_ONCE_GRACE_MINUTES=10
# Job "once" bị trần ngày chặn thì đẩy sang giờ này (0-23) của ngày mai, không
# dồn về 00:00 (tránh cả loạt job hoãn bắn thành 1 chùm lúc nửa đêm)
SCHEDULER_DEFERRED_RUN_HOUR=8
# Số lượt chạy gần nhất giữ lại mỗi job trong lịch sử
SCHEDULER_RUN_LOG_KEEP=50

# ===== Dashboard web =====
# Server bind 127.0.0.1 - trên VPS PHẢI đứng sau Caddy/Nginx (không expose port trực tiếp)
DASHBOARD_PORT=3900
# BẮT BUỘC đặt password mạnh (dashboard đọc được toàn bộ hội thoại). Không set = tắt.
# Đổi được từ trang Cấu hình trên dashboard; đổi rồi thì mật khẩu MỚI (lưu dạng
# hash trong DB) thắng giá trị ở đây, và biến này chỉ còn là công tắc bật/tắt.
# Sau khi đổi qua web, giá trị dưới đây KHÔNG còn đăng nhập được - đừng tưởng
# sửa lại file này là lấy lại được quyền vào. QUÊN MẬT KHẨU thì khôi phục bằng:
#   sqlite3 data/zalo-agent.db "DELETE FROM runtime_settings WHERE key='dashboard_password';"
# (xóa xong đăng nhập lại bằng đúng giá trị đặt ở dòng dưới)
DASHBOARD_PASSWORD=
# PHẢI để true khi đã có Caddy/Nginx đứng trước và phục vụ qua HTTPS:
# - rate-limit login lấy IP client từ X-Forwarded-For do proxy ghi (entry phải nhất);
#   để false thì mọi request đều tính chung 1 IP là 127.0.0.1 -> 5 lần/phút cho CẢ THIÊN HẠ
# - cookie session được gắn cờ Secure (chỉ đi qua HTTPS)
# Nếu truy cập trực tiếp qua http (vd SSH tunnel vào 127.0.0.1) thì để false;
# để true lúc đó trình duyệt sẽ không gửi cookie và không đăng nhập được.
DASHBOARD_BEHIND_PROXY=true

# ===== Security =====
# BẮT BUỘC khác với key dev; mất key này = mất toàn bộ cookie đã lưu (phải quét QR lại)
CREDENTIALS_ENCRYPTION_KEY=
