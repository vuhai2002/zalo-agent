# =============================================================================
# PRODUCTION - chỉ cần điền 2 dòng ở CUỐI file này
# =============================================================================
#
# Mọi thứ khác đã có mặc định dùng được, hoặc cấu hình trên dashboard.
# Thứ tự ưu tiên ở mọi nơi:
#
#     giá trị trên dashboard  >  biến trong .env  >  mặc định trong code
#
# Nghĩa là đặt lại ở đây cũng KHÔNG thắng được dashboard. Muốn ghim cứng một
# tham số cho môi trường production thì phải xóa nó trên dashboard, đừng ghi đè
# ở đây rồi tưởng là xong.
#
# KHÔNG có nhà cung cấp LLM, model hay API key trong file này. Chúng nhập ở
# dashboard (Cấu hình > Nhà cung cấp LLM) và lưu vào DB, API key được mã hóa.
# Để lại đây thì giá trị cũ nằm im trong khi DB đang gánh, người đọc file tưởng
# đó là cấu hình đang chạy.
#
# Deploy tự động không có ai bấm dashboard thì đặt thẳng biến môi trường - tên
# biến tra đủ trong src/config/env.ts (vd LLM_API_KEY, LLM_MODEL, LLM_BASE_URL).


# =============================================================================
# PHẦN 1 - ĐỂ NGUYÊN CŨNG CHẠY ĐƯỢC
# =============================================================================
# Mấy biến này đọc MỘT LẦN lúc khởi động nên không đưa lên dashboard được, sửa
# xong phải chạy lại bot.

# production: log JSON (không dùng pino-pretty) để máy đọc được
NODE_ENV=production
# Nơi chứa DB, cookie Zalo đã mã hóa, ảnh tải về. Trên VPS nên trỏ ra ngoài thư
# mục code để deploy không đụng vào dữ liệu, vd /var/lib/zalo-agent
DATA_DIR=./data

LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_KEEP_DAYS=14

# Cổng chỉ bind localhost, KHÔNG phơi thẳng ra internet - Docker tự chọc thủng
# UFW nếu map kiểu -p 3900:3900. Cho Caddy/Nginx forward vào 127.0.0.1:3900.
DASHBOARD_PORT=3900
# BẮT BUỘC true khi chạy sau reverse proxy HTTPS: cookie session mới có cờ
# Secure, và rate-limit login mới đọc đúng IP client từ X-Forwarded-For.
DASHBOARD_BEHIND_PROXY=true


# =============================================================================
# PHẦN 2 - PHẢI ĐIỀN, KHÔNG CÓ MẶC ĐỊNH
# =============================================================================

# Khóa mã hóa cookie Zalo và các API key lưu trong DB.
#
# Đây là biến DUY NHẤT thiếu là bot KHÔNG KHỞI ĐỘNG ĐƯỢC, và nó không thể nằm
# trên dashboard vì chính nó dùng để giải mã những gì dashboard lưu.
#
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ĐỔI KHÓA NÀY = mất toàn bộ phiên Zalo đã lưu và mọi API key đã nhập trên web.
# BACKUP nó cùng chỗ với backup DB - mất khóa thì bản backup DB thành vô dụng.
CREDENTIALS_ENCRYPTION_KEY=

# Mật khẩu đăng nhập dashboard, tối thiểu 8 ký tự.
#
# Không đặt = dashboard TẮT HẲN, và lúc đó không còn đường nào nhập cấu hình
# LLM nên bot cũng không trả lời được. Đặt một lần ở đây để vào lần đầu, sau đó
# đổi ngay trên web (đổi trên web ghi vào DB và thắng dòng này).
DASHBOARD_PASSWORD=
