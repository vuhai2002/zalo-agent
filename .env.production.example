# ===== Runtime =====
# production: log JSON (khong pino-pretty), level warn tro len de giam noise
NODE_ENV=production
LOG_LEVEL=info
# Tren VPS nen tro ra ngoai thu muc code, vd /var/lib/zalo-agent
DATA_DIR=./data

# ===== LLM =====
# Router proxy phai chay 24/7 cung voi bot; neu router chet bot se retry roi bao loi
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://9router.vuhai.io.vn/v1
LLM_API_KEY=sk-prod-key
LLM_MODEL=claude-opus-5
# Gioi han buoc tool + token moi luot de chan chay vi khi bi spam
LLM_MAX_STEPS=8
LLM_MAX_OUTPUT_TOKENS=2048

# ===== Agent behavior =====
HISTORY_CONTEXT_LIMIT=20
# Chan file SQLite phinh vo han khi bot chay dai ngay: moi thread chi giu 500 tin
# moi nhat, tin cu hon bi XOA han sau moi lan ghi. Nang len neu sau nay can doc
# lai lich su dai (dashboard, thong ke). Phai >= HISTORY_CONTEXT_LIMIT.
HISTORY_MAX_MESSAGES_PER_THREAD=500
# Prod nen giu delay >= 800ms de giam nguy co Zalo danh dau spam
SEND_DELAY_MIN_MS=800
SEND_DELAY_MAX_MS=2500
# Gop tin cung thread: 2500ms hop ly cho chat nguoi that; ha xuong neu can phan hoi nhanh hon
MESSAGE_BATCH_DEBOUNCE_MS=2500

# ===== Security =====
# BAT BUOC khac voi key dev; mat key nay = mat toan bo cookie da luu (phai quet QR lai)
CREDENTIALS_ENCRYPTION_KEY=
