{
  "name": "zalo-agent",
  "version": "0.3.1",
  "private": true,
  "description": "Bot AI thường trú trên Zalo cá nhân, đa tài khoản: agent loop tự gọi tool (kể cả tool từ MCP server ngoài), dashboard web, lịch hẹn, trí nhớ bền, tin nhắn có định dạng. Self-hosted, provider-agnostic.",
  "keywords": [
    "zalo",
    "zalo-bot",
    "zalo-ai",
    "zca-js",
    "ai-agent",
    "llm-agent",
    "chatbot",
    "vietnamese",
    "tool-calling",
    "function-calling",
    "mcp",
    "model-context-protocol",
    "vercel-ai-sdk",
    "openai-compatible",
    "anthropic",
    "self-hosted",
    "multi-account",
    "sqlite",
    "typescript",
    "hono",
    "react",
    "prompt-injection-defense",
    "scheduler",
    "cron",
    "rich-text",
    "personal-assistant"
  ],
  "license": "MIT",
  "homepage": "https://github.com/vuhai2002/zalo-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuhai2002/zalo-agent.git"
  },
  "bugs": {
    "url": "https://github.com/vuhai2002/zalo-agent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite web",
    "start": "tsx src/index.ts",
    "zalo-login": "tsx scripts/login-account.ts",
    "test": "node --import tsx --test --test-timeout=60000 \"src/**/*.test.ts\" \"web/src/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build web",
    "eval": "tsx evals/run-eval.ts",
    "zalo-bot-check": "tsx src/zalo-bot/kiem-chung-bot-api.ts"
  },
  "packageManager": "pnpm@11.28.7+sha512.2161a30a2dc64b0c0f09786496fbce5f061be96b8ff11f0bc98e6bc675e0074ceb225b9197a278f2f171e6c9fb971bd1df8932e5bc31053baccdd52b15a1ae26",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/mcp": "^2.0.83",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.150",
    "cron-parser": "^5.10.2",
    "docx": "^9.14.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "luxon": "^3.7.2",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "saxes": "^6.0.0",
    "unpdf": "^1.9.1",
    "zca-js": "2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
