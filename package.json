{
  "name": "zalo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Bot AI thường trú trên Zalo cá nhân, đa tài khoản: agent loop tự gọi tool, dashboard web, lịch hẹn, trí nhớ bền, tin nhắn có định dạng. Self-hosted, provider-agnostic.",
  "keywords": [
    "zalo",
    "zalo-bot",
    "zalo-ai",
    "zca-js",
    "ai-agent",
    "llm-agent",
    "chatbot",
    "vietnamese",
    "tool-calling",
    "function-calling",
    "vercel-ai-sdk",
    "openai-compatible",
    "anthropic",
    "self-hosted",
    "multi-account",
    "sqlite",
    "typescript",
    "hono",
    "react",
    "prompt-injection-defense",
    "scheduler",
    "cron",
    "rich-text",
    "personal-assistant"
  ],
  "license": "MIT",
  "homepage": "https://github.com/vuhai2002/zalo-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuhai2002/zalo-agent.git"
  },
  "bugs": {
    "url": "https://github.com/vuhai2002/zalo-agent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite web",
    "start": "tsx src/index.ts",
    "zalo-login": "tsx scripts/login-account.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"web/src/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build web",
    "eval": "tsx evals/run-eval.ts"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.19",
    "@ai-sdk/google": "^4.0.33",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@hono/node-server": "^2.0.11",
    "ai": "^7.0.37",
    "cron-parser": "^5.6.2",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "hono": "^4.12.32",
    "image-size": "^2.0.2",
    "luxon": "^3.7.2",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "zca-js": "2.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
