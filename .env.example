# ===== Runtime =====
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM =====
# openai-compatible: tro router proxy (9Router, LiteLLM, OpenRouter...) qua LLM_BASE_URL
# anthropic: goi thang API Anthropic (khong can LLM_BASE_URL)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://9router.vuhai.io.vn/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=claude-opus-5
LLM_MAX_STEPS=8
LLM_MAX_OUTPUT_TOKENS=2048

# ===== Agent behavior =====
HISTORY_CONTEXT_LIMIT=20
SEND_DELAY_MIN_MS=800
SEND_DELAY_MAX_MS=2500
# Cho gop tin nhan cung thread trong X ms thanh 1 luot agent (anh + caption di rieng nhau)
MESSAGE_BATCH_DEBOUNCE_MS=2500

# ===== Security =====
# Khoa ma hoa cookie Zalo luu tren dia (bat buoc, 64 hex chars)
# Tao bang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
