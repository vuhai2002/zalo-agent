# =============================================================================
# .env CHỈ CÒN NHỮNG THỨ PHẢI BIẾT TRƯỚC KHI CÓ DASHBOARD
# =============================================================================
#
# Gần như mọi tham số đã chuyển lên dashboard. Thứ tự ưu tiên ở mọi nơi:
#
#     giá trị trên dashboard  >  biến trong .env  >  mặc định trong code
#
# Nghĩa là để trống ở đây thì bot vẫn chạy bằng mặc định, và chỉnh trên web là
# có hiệu lực từ lượt sau, không cần khởi động lại.
#
# Vì sao KHÔNG liệt kê lại hết ở đây nữa: giá trị cũ nằm lại trong .env trong
# khi dashboard đang gánh là chuyện đã xảy ra thật, và người đọc file tưởng đó
# là cấu hình đang chạy. Một danh sách sai còn tệ hơn không có danh sách.
#
# Muốn xem/chỉnh phần còn lại:
#   trang Cấu hình    46 tham số (giới hạn lượt, lịch hẹn, gửi tin, ảnh, trace...)
#   trang Providers   nhà cung cấp LLM, base URL, model, API key
#   trang Công cụ     tìm kiếm web, đọc trang, vẽ ảnh, đọc ảnh
#
# Chạy trong Docker/CI không có ai bấm dashboard thì cứ đặt thẳng biến môi
# trường - tên biến giữ nguyên như cũ, tra đủ trong src/config/env.ts.

# ===== BẮT BUỘC =====
# Khóa mã hóa cookie Zalo và các API key lưu trong DB. Đây là biến DUY NHẤT
# thiếu là bot không khởi động được - và nó không thể nằm trên dashboard, vì
# chính nó dùng để giải mã những gì dashboard lưu.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ĐỔI KHÓA NÀY = mất toàn bộ phiên Zalo đã lưu và mọi API key đã nhập trên web.
CREDENTIALS_ENCRYPTION_KEY=

# ===== VÀO ĐƯỢC DASHBOARD =====
# Không đặt mật khẩu = dashboard TẮT hẳn. Đặt một lần ở đây để đăng nhập lần
# đầu, sau đó đổi ngay trên web (đổi trên web ghi vào DB và thắng dòng này).
DASHBOARD_PASSWORD=
DASHBOARD_PORT=3900
# Chạy sau reverse proxy HTTPS (Caddy/Nginx) thì bật. PHẢI để false khi vào
# thẳng qua http, không thì cookie không bao giờ được gửi và không đăng nhập được.
DASHBOARD_BEHIND_PROXY=false

# ===== ĐỌC MỘT LẦN LÚC KHỞI ĐỘNG =====
# Những biến dưới đây đọc TRƯỚC khi mở được DB nên không thể nằm trên dashboard.
NODE_ENV=development
DATA_DIR=./data
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_FILE_KEEP_DAYS=7

# ===== LLM: dự phòng cho lần chạy đầu =====
# Nhập ở trang Providers thì bỏ trống cả khối này. Để sẵn đây chỉ tiện cho lần
# khởi động đầu tiên hoặc khi chạy headless.
#   openai-compatible: trỏ router proxy (9Router, LiteLLM, OpenRouter...) qua LLM_BASE_URL
#   anthropic: gọi thẳng API Anthropic (không cần LLM_BASE_URL)
# Tên model phải khớp ĐÚNG danh sách router trả về - 9Router đặt tên có tiền tố
# nhà cung cấp (vd "cx/gpt-5.6-sol"), ghi thiếu là router trả 404 "No active
# credentials for provider". Xem danh sách thật:
#   curl -H "Authorization: Bearer $LLM_API_KEY" $LLM_BASE_URL/models
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
