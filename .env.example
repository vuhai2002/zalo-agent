# ===== Runtime =====
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM =====
# openai-compatible: tro router proxy (9Router, LiteLLM, OpenRouter...) qua LLM_BASE_URL
# anthropic: goi thang API Anthropic (khong can LLM_BASE_URL)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://9router.vuhai.io.vn/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=claude-opus-5
LLM_MAX_STEPS=8
LLM_MAX_OUTPUT_TOKENS=2048

# ===== Agent behavior =====
HISTORY_CONTEXT_LIMIT=20
# Memory: du N tin roi khoi cua so replay thi gop vao summary cua thread (1 LLM call nho, chay async)
SUMMARY_TRIGGER_MESSAGES=30
# Toi da bao nhieu fact (save_memory tool) cho moi nguoi/nhom; day thi xoa fact cu nhat
MEMORY_MAX_FACTS_PER_SUBJECT=50
# Giu toi da bao nhieu tin moi thread; tin cu hon bi xoa sau moi lan ghi.
# Phai >= HISTORY_CONTEXT_LIMIT.
HISTORY_MAX_MESSAGES_PER_THREAD=500
SEND_DELAY_MIN_MS=800
SEND_DELAY_MAX_MS=2500
# Cho gop tin nhan cung thread trong X ms thanh 1 luot agent (anh + caption di rieng nhau)
MESSAGE_BATCH_DEBOUNCE_MS=2500

# ===== Dashboard web =====
# Server quan tri (xem hoi thoai, contacts, bat/tat bot) - bind 127.0.0.1
DASHBOARD_PORT=3900
# Khong set = dashboard tat. Toi thieu 8 ky tu.
DASHBOARD_PASSWORD=

# ===== Security =====
# Khoa ma hoa cookie Zalo luu tren dia (bat buoc, 64 hex chars)
# Tao bang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
