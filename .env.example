# Phần lớn tham số dưới đây giờ chỉnh được ngay trên dashboard, ở trang
# "Cấu hình" - đổi là có hiệu lực từ lượt sau, không cần khởi động lại.
# Giá trị trong file này là MẶC ĐỊNH: ô nào chưa chỉnh trên web thì lấy ở đây.
# Riêng NODE_ENV, LOG_*, DATA_DIR, DASHBOARD_* đọc một lần lúc khởi động nên
# vẫn phải sửa ở đây rồi chạy lại bot.

# ===== Runtime =====
NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM =====
# openai-compatible: trỏ router proxy (9Router, LiteLLM, OpenRouter...) qua LLM_BASE_URL
# anthropic: gọi thẳng API Anthropic (không cần LLM_BASE_URL)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://9router.vuhai.io.vn/v1
# Để trống được: nhập key ở trang Providers trên dashboard (lưu DB, mã hóa).
# Thiếu cả 2 nơi thì bot vẫn khởi động bình thường nhưng không trả lời được
# (có log cảnh báo lúc boot).
LLM_API_KEY=sk-your-key-here
LLM_MODEL=claude-opus-5
LLM_MAX_STEPS=8
# Trần thời gian cho cả lượt agent (ms). Phải LỚN HƠN IMAGE_GEN_TIMEOUT_MS,
# vì thời gian vẽ ảnh nằm trong lượt. Mặc định 15 phút.
LLM_TURN_TIMEOUT_MS=900000
# Trần token model sinh mỗi lượt. Lượt tốn nhất là gọi tool tạo file (.docx/.xlsx):
# model viết cả nội dung file vào tool call. Đo thật báo cáo 6 sheet ~7.100 token
# payload, cộng reasoning + câu trả lời -> 16384 là vừa đủ có biên.
# Hạ xuống dưới ~12000 thì phải hạ DOCUMENT_MAX_CHARS theo, không thì model bị
# cắt giữa tool call và mất cả lượt. Đây là TRẦN chứ không phải mục tiêu -
# trả lời chat thường vẫn chỉ vài trăm token.
LLM_MAX_OUTPUT_TOKENS=16384
# Mức "suy nghĩ" của model: off | low | medium | high | xhigh.
# Bật (medium trở lên) giúp việc cần nghĩ từng bước - đọc bảng số, đối chiếu vé,
# đọc kỹ ảnh - chính xác hơn hẳn, đổi lại tốn thêm token và chậm hơn chút.
# openai-compatible: gửi reasoning_effort qua router; anthropic: adaptive thinking.
LLM_REASONING_EFFORT=medium
# Gửi header x-session-id ổn định theo từng cuộc chat để router bật prompt caching.
# Không gửi thì 9Router tự băm nội dung câu trả lời để làm khóa - nội dung đó dài
# thêm mỗi lượt nên khóa đổi liên tục và cache KHÔNG BAO GIỜ trúng.
# Header này dùng chung mọi provider (Codex/Grok đổ vào prompt_cache_key, Anthropic
# dùng cho fingerprint, provider khác bỏ qua vô hại). Tắt nếu router đổi quy ước.
LLM_CACHE_SESSION_ENABLED=true

# ===== Đọc ảnh (vision) =====
# Model chính có đọc được ảnh không: auto | on | off.
# auto = tự hỏi router qua GET {LLM_BASE_URL}/models (9Router trả capabilities.vision
#        cho từng model; endpoint khác không có field này thì coi như đọc được).
# on/off = ép tay - dùng khi endpoint không phải 9Router mà model không có vision.
LLM_VISION_MODE=auto
# Model phụ "đọc ảnh thuê" khi model chính không có vision: mô tả ảnh thành text
# 1 lần (cache trong DB), model chính đọc text mô tả. Để trống = không dùng,
# bot sẽ nói thật là không xem được ảnh. Nên cấu hình ở trang Providers trên
# dashboard (key lưu DB, mã hóa) - env chỉ là giá trị khởi điểm.
# Gemini free tier là lựa chọn tiêu chuẩn (~500 lượt/ngày với flash-lite đời mới;
# số thật xem trang Rate Limit của AI Studio - thế hệ cũ như 2.5-flash-lite đã bị
# Google rút serving, gọi là 404 dù vẫn nằm trong /models):
#   VISION_SIDECAR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   VISION_SIDECAR_MODEL=gemini-3.5-flash-lite
VISION_SIDECAR_BASE_URL=
VISION_SIDECAR_MODEL=
VISION_SIDECAR_API_KEY=

# ===== Agent behavior =====
# Múi giờ của bot (IANA): bơm ngày vào system prompt + tool get_datetime
BOT_TIMEZONE=Asia/Ho_Chi_Minh
# Key Brave DỰ PHÒNG. Nên nhập ở trang Tools trên dashboard (lưu DB, mã hóa)
# thay vì để đây; env chỉ được dùng khi DB chưa có key.
# DuckDuckGo luôn là nguồn dự phòng cuối nên thiếu key vẫn tìm được.
BRAVE_SEARCH_API_KEY=
# Số kết quả web search tối đa trả cho agent mỗi lần tìm
WEB_SEARCH_MAX_RESULTS=5
# Số ký tự tối đa web_fetch trả cho model mỗi lần đọc trang.
# Đừng hạ dưới 10000: trang tin Việt Nam nhiều rác đầu trang, cắt sớm quá là
# bot không thấy nội dung thật (đã dính lỗi này với bảng kết quả xổ số).
WEB_FETCH_MAX_CHARS=15000
# Fetch tự làm hỏng hoặc ra quá ít chữ (trang render bằng JavaScript, chặn bot)
# thì đẩy URL qua Jina Reader (r.jina.ai, không cần key). Đo thực tế: cứu được
# giavang.doji.vn và vnexpress. Đánh đổi: chậm hơn nhiều (1-16s) và URL đi qua
# bên thứ ba - để false nếu không muốn.
WEB_FETCH_FALLBACK_ENABLED=true
HISTORY_CONTEXT_LIMIT=20
# Nạp lại tối đa N ảnh gần nhất trong history vào context để bot "nhớ" ảnh cũ (0 = tắt).
# MỖI ảnh tốn ~1500-2500 token và bị gửi lại ở MỌI bước tool của lượt agent,
# nên tăng lên là nhân chi phí rất nhanh. 1 là đủ cho "hỏi lại về ảnh vừa gửi".
HISTORY_IMAGE_CONTEXT_LIMIT=1
# Cỡ ảnh lấy từ tin nhắn Zalo: normal | hd | thumb.
# Zalo gửi kèm nhiều cỡ của cùng 1 ảnh; lấy hd (bản to nhất) tốn gấp mấy lần
# token mà không giúp đọc chữ số rõ hơn. thumb rẻ nhất nhưng hay mất chữ số.
ZALO_IMAGE_QUALITY=normal
# Ảnh nhận được lưu vào data/media; file cũ hơn N ngày bị xóa (dọn lúc khởi động + mỗi 24h)
MEDIA_RETENTION_DAYS=7
# ===== Tool tạo file .docx / .xlsx =====
# Giới hạn nội dung mỗi file bot tạo. Bot đọc tin người lạ nên phải chặn trước:
# nội dung khổng lồ vừa tốn CPU/đĩa vừa ra file không ai đọc nổi.
DOCUMENT_MAX_BLOCKS=60
DOCUMENT_MAX_ROWS=200
DOCUMENT_MAX_CHARS=20000
DOCUMENT_MAX_SHEETS=10
# Số file tối đa 1 cuộc chat được tạo trong 1 giờ - chặn spam "xuất file" liên tục
DOCUMENT_MAX_PER_HOUR=10

# ===== Tool vẽ ảnh AI =====
# Endpoint OpenAI-compatible /v1/images/generations (9Router, OpenAI, gateway bất
# kỳ nói cùng giao thức). Chỉ điền phần gốc, bot tự nối đường dẫn.
# Cấu hình được từ dashboard (Settings của dòng "Vẽ ảnh AI" ở trang Tools) - env
# chỉ là giá trị khởi điểm, DB đè lên env.
# Model PHẢI gõ tay: /v1/models chỉ liệt kê model chat, model vẽ ảnh không có ở đó.
#   IMAGE_GEN_BASE_URL=https://9router.example.com
#   IMAGE_GEN_MODEL=cx/gpt-5.5-image
IMAGE_GEN_BASE_URL=
IMAGE_GEN_MODEL=
IMAGE_GEN_API_KEY=
# Trần số ảnh 1 cuộc chat vẽ được mỗi giờ. Chặt hơn tool tạo file vì mỗi ảnh là
# một lần TRẢ TIỀN cho nhà cung cấp và chiếm ~70 giây, trong khi dựng .docx chỉ
# tốn CPU của mình.
IMAGE_GEN_MAX_PER_HOUR=10
# ===== Log ra file =====
# Không bật thì log CHỈ tồn tại trong terminal đang chạy bot - đóng terminal là
# mất sạch, và trên VPS thì không còn gì để lần lại khi có sự cố.
# File nằm ở data/logs/bot.<ngày>.log, xoay vòng mỗi ngày một file.
# FILE ghi MỌI mức kể cả debug, KHÔNG phụ thuộc LOG_LEVEL ở trên: terminal cần
# gọn để đọc lướt, file cần đủ vì lúc cần tới nó là sự cố đã xảy ra rồi.
# Xem lại trên dashboard ở trang Logs.
LOG_FILE_ENABLED=true
# Giữ lại bao nhiêu file cũ (1 file/ngày)
LOG_FILE_KEEP_DAYS=7

# ===== Trace từng step của lượt agent =====
# Ghi lại model nói gì, gọi tool nào với THAM SỐ gì, provider cảnh báo gì. Không
# có cái này thì bot trả lời sai chỉ còn cách suy luận ngược từ câu lỗi.
# Xem trên dashboard (trang Sessions, bấm vào một lượt) hoặc trong log khi để
# LOG_LEVEL=debug.
AGENT_TRACE_ENABLED=true
# Trần ký tự mỗi mẩu nội dung. Trace chứa NGUYÊN VĂN tin nhắn của người thật nên
# cắt ngắn vừa đỡ phình DB vừa đỡ lưu dư thông tin cá nhân. Phần bị cắt vẫn ghi
# kèm độ dài thật để biết mình đang mất bao nhiêu.
AGENT_TRACE_MAX_CHARS=500
# Dọn trace cũ hơn N ngày (chạy cùng nhịp dọn media). Bảng agent_steps phình
# nhanh nhất trong DB nên đừng để quá lớn.
AGENT_TRACE_RETENTION_DAYS=7

# Mức chi tiết khi vẽ: auto | low | medium | high | standard | hd
# Đo A/B cùng một prompt: "high" ra ảnh giàu chi tiết hơn hẳn mà KHÔNG chậm hơn
# (50 giây so với 60 giây). Đổi lại nhà cung cấp thường tính phí cao hơn mức mặc
# định - hạ xuống "medium" nếu thấy tốn. "standard"/"hd" là của dòng dall-e.
IMAGE_GEN_QUALITY=high
# Im lặng bao lâu (ms) thì coi là kết nối đã chết. Đây mới là phép đo đúng cho
# stream: đo thật trên prompt nặng (tổng 135 giây), nhà cung cấp bắn keepalive
# đều mỗi 30 giây nên khoảng im lặng dài nhất chỉ 30.1 giây. 90s = gấp 3 lần.
# Vẽ lâu mà stream còn chảy là KHỎE; im lặng lâu mới là chết.
IMAGE_GEN_STALL_MS=90000
# Chốt chặn cuối cho cả lượt vẽ (ms). Không phải để cắt lượt vẽ chậm - trần im
# lặng ở trên lo việc đó. Cái này chỉ chặn ca nhà cung cấp bắn keepalive mãi mà
# không bao giờ vẽ xong.
IMAGE_GEN_TIMEOUT_MS=600000

# Memory: đủ N tin rớt khỏi cửa sổ replay thì gộp vào summary của thread
# (1 LLM call nhỏ, chạy async sau khi đã trả lời)
SUMMARY_TRIGGER_MESSAGES=30
# Tối đa bao nhiêu fact (tool save_memory) cho mỗi người/nhóm; đầy thì xóa fact cũ nhất
MEMORY_MAX_FACTS_PER_SUBJECT=50
# Giữ tối đa bao nhiêu tin mỗi thread; tin cũ hơn bị xóa sau mỗi lần ghi.
# Phải >= HISTORY_CONTEXT_LIMIT.
HISTORY_MAX_MESSAGES_PER_THREAD=500
SEND_DELAY_MIN_MS=800
SEND_DELAY_MAX_MS=2500
# Zalo chặn tin quá dài (lỗi "Nội dung quá dài") -> câu trả lời dài bị cắt thành
# nhiều tin, cắt ở dòng trống/xuống dòng/hết câu, không bao giờ cắt giữa từ.
ZALO_MAX_MESSAGE_CHARS=2000
# Trần số tin cho 1 lượt trả lời; vượt trần thì đoạn cuối kèm ghi chú "phần sau còn dài"
ZALO_MAX_MESSAGE_PARTS=5
# Chờ gộp tin nhắn cùng thread trong X ms thành 1 lượt agent (ảnh + caption Zalo gửi tách nhau)
MESSAGE_BATCH_DEBOUNCE_MS=2500
# Chu kỳ bắn lại sự kiện "đang nhập" (Zalo không có API tắt, chỉ báo tự hết sau vài giây)
TYPING_REFRESH_MS=3000

# ===== Lịch hẹn (scheduler): bot tự nhắn theo lịch =====
# Tắt thì vòng tick không chạy - job vẫn nằm nguyên trong DB, không job nào được gửi.
SCHEDULER_ENABLED=true
# Chu kỳ quét job đến hạn (ms)
SCHEDULER_TICK_MS=30000
# Chặn every/cron dày hơn mức này NGAY LÚC TẠO job (phút) - lưới đỡ đầu chống
# spam. every 1m = 1440 tin/ngày vào một nick cá nhân, đúng chữ ký khoá nick.
SCHEDULER_MIN_INTERVAL_MINUTES=5
# Trần số job đang bật mỗi cuộc trò chuyện
SCHEDULER_MAX_JOBS_PER_THREAD=20
# Trần tin CHỦ ĐỘNG (job tự bắn, không phải trả lời) mỗi thread mỗi ngày -
# đếm theo ngày BOT_TIMEZONE. Lưới đỡ cuối, độc lập với chặn lúc tạo job.
SCHEDULER_MAX_PROACTIVE_PER_DAY=10
# Rải đều tin chủ động: hàng đợi TOÀN CỤC, cách nhau chừng này (ms) giữa 2 tin
# chủ động bất kỳ thread nào
SCHEDULER_SEND_GAP_MS=20000
# Job "once" trễ trong khoảng này (phút) vẫn gửi bình thường; trễ hơn vẫn gửi
# (không nuốt im lặng lời nhắc) nhưng kèm nhãn "nhắc trễ"
SCHEDULER_ONCE_GRACE_MINUTES=10
# Job "once" bị trần ngày chặn thì đẩy sang giờ này (0-23) của NGÀY MAI, không
# phải 00:00 - tránh dồn cả loạt job hoãn thành 1 chùm tin đúng lúc nửa đêm
SCHEDULER_DEFERRED_RUN_HOUR=8
# Giữ tối đa bấy nhiêu lượt chạy gần nhất mỗi job, cũ hơn bị dọn tự động
SCHEDULER_RUN_LOG_KEEP=50

# ===== Dashboard web =====
# Server quản trị (xem hội thoại, contacts, bật/tắt bot) - bind 127.0.0.1
DASHBOARD_PORT=3900
# Không set = dashboard tắt. Tối thiểu 8 ký tự.
# Đổi được từ trang Cấu hình trên dashboard; đổi rồi thì mật khẩu MỚI (lưu dạng
# hash trong DB) thắng giá trị ở đây, và biến này chỉ còn là công tắc bật/tắt.
DASHBOARD_PASSWORD=
# Dashboard đứng sau reverse proxy HTTPS (Caddy/Nginx)? Dev trên máy thì để false.
# false: rate-limit login tính theo IP socket, KHÔNG tin header X-Forwarded-For
#        (header đó client gửi được -> đổi mỗi request là né được rate limit)
# true : tin XFF do proxy ghi (lấy entry phải nhất) + gắn cờ Secure vào cookie
DASHBOARD_BEHIND_PROXY=false

# ===== Security =====
# Khóa mã hóa cookie Zalo lưu trên đĩa (bắt buộc, 64 ký tự hex)
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
