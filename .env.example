# =============================================================================
# CLONE VỀ LÀ CHẠY ĐƯỢC - chỉ cần điền 2 dòng ở CUỐI file này
# =============================================================================
#
# Mọi thứ khác đã có mặc định dùng được, hoặc cấu hình trên dashboard.
# Thứ tự ưu tiên ở mọi nơi:
#
#     giá trị trên dashboard  >  biến trong .env  >  mặc định trong code
#
# KHÔNG có nhà cung cấp LLM, model hay API key trong file này. Chúng nhập trên
# dashboard và lưu vào DB - để lại đây thì giá trị cũ nằm im trong khi DB đang
# gánh, người đọc file tưởng đó là cấu hình đang chạy. Đã xảy ra thật.
#
# Sau khi chạy, vào dashboard cấu hình nốt:
#   Cấu hình > Nhà cung cấp LLM   base URL, model, API key  <- LÀM TRƯỚC TIÊN
#   Accounts                      thêm tài khoản Zalo + quét QR đăng nhập
#   Agents                        persona, model riêng, công cụ của từng agent
#   Tools                         tìm kiếm web, đọc trang, vẽ ảnh, đọc ảnh
#   Cấu hình                      46 tham số (lượt, lịch hẹn, gửi tin, trace)
#
# Deploy tự động không có ai bấm dashboard thì đặt thẳng biến môi trường -
# tên biến tra đủ trong src/config/env.ts (vd LLM_API_KEY, LLM_MODEL).


# =============================================================================
# PHẦN 1 - ĐỂ NGUYÊN CŨNG CHẠY ĐƯỢC
# =============================================================================
# Mấy biến này đọc MỘT LẦN lúc khởi động nên không đưa lên dashboard được, sửa
# xong phải chạy lại bot. Nhưng mặc định đã hợp lý, không cần đụng.

NODE_ENV=development
# Nơi chứa DB, cookie Zalo đã mã hóa, ảnh tải về. Trên VPS nên trỏ ra ngoài thư
# mục code, vd /var/lib/zalo-agent
DATA_DIR=./data

LOG_LEVEL=info
LOG_FILE_ENABLED=true
# Giữ lại bao nhiêu file log cũ (1 file/ngày)
LOG_FILE_KEEP_DAYS=7

DASHBOARD_PORT=3900
# Chạy sau reverse proxy HTTPS (Caddy/Nginx) thì bật. PHẢI để false khi vào
# thẳng qua http, không thì cookie không bao giờ được gửi và không đăng nhập được.
DASHBOARD_BEHIND_PROXY=false


# =============================================================================
# PHẦN 2 - PHẢI ĐIỀN, KHÔNG CÓ MẶC ĐỊNH
# =============================================================================

# Khóa mã hóa cookie Zalo và các API key lưu trong DB.
#
# Đây là biến DUY NHẤT thiếu là bot KHÔNG KHỞI ĐỘNG ĐƯỢC, và nó không thể nằm
# trên dashboard vì chính nó dùng để giải mã những gì dashboard lưu.
#
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ĐỔI KHÓA NÀY = mất toàn bộ phiên Zalo đã lưu và mọi API key đã nhập trên web.
# Backup nó cùng chỗ với backup DB - mất khóa thì bản backup DB thành vô dụng.
CREDENTIALS_ENCRYPTION_KEY=

# Mật khẩu đăng nhập dashboard, tối thiểu 8 ký tự.
#
# Không đặt = dashboard TẮT HẲN, và lúc đó không còn đường nào nhập cấu hình
# LLM nên bot cũng không trả lời được. Đặt một lần ở đây để vào lần đầu, sau đó
# đổi ngay trên web (đổi trên web ghi vào DB và thắng dòng này).
DASHBOARD_PASSWORD=
